networks:
  {{ network.name }}:
    driver: {{ network.driver_type }}
  opa-internal:
    driver: bridge

volumes:
  {{ services.log_volume }}:

services:

  app:
    image: {{ services.image }}
    container_name: swiftdeploy-app
    restart: {{ services.restart_policy }}
    user: "appuser"
    cap_drop:
      - ALL
    environment:
      - MODE={{ services.mode }}
      - APP_VERSION={{ services.version }}
      - APP_PORT={{ services.port }}
    volumes:
      - {{ services.log_volume }}:/app/logs
    networks:
      - {{ network.name }}
    expose:
      - "{{ services.port }}"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ services.port }}/healthz"]
      interval: 10s
      timeout: 5s
      retries: 6

  nginx:
    image: {{ nginx.image }}
    container_name: swiftdeploy-nginx
    restart: {{ services.restart_policy }}
    ports:
      - "{{ nginx.port }}:{{ nginx.port }}"
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
    networks:
      - {{ network.name }}
    depends_on:
      - app

  opa:
    image: openpolicyagent/opa:latest-rootless
    container_name: swiftdeploy-opa
    restart: {{ services.restart_policy }}
    command:
      - "run"
      - "--server"
      - "--addr=0.0.0.0:8181"
      - "--log-level=error"
      - "/policies"
    volumes:
      - ./policies:/policies:ro
    networks:
      - opa-internal
    ports:
      - "8181:8181"
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "-", "http://localhost:8181/health"]
      interval: 10s
      timeout: 5s
      retries: 6