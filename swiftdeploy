#!/bin/bash
# ═══════════════════════════════════════════════════════
#  SwiftDeploy CLI
#  Usage: ./swiftdeploy [init|validate|deploy|promote|status|audit|teardown]


set -euo pipefail

# ── Config variables ────────────────────────────────────────────────────────
MANIFEST="manifest.yaml"
COMPOSE_FILE="docker-compose.yml"
NGINX_CONF="nginx.conf"
TEMPLATES_DIR="templates"
OPA_URL="http://localhost:8181"
HISTORY_FILE="history.jsonl"

# ── Colours for output ──────────────────────────────────────────────────────
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

pass() { echo -e "${GREEN}[PASS]${NC} $1"; }
fail() { echo -e "${RED}[FAIL]${NC} $1"; }
info() { echo -e "${YELLOW}[INFO]${NC} $1"; }

# ══════════════════════════════════════════════════════
#  HELPER: Parse a value from manifest.yaml
#  Usage: get_manifest "nginx.port"
# ══════════════════════════════════════════════════════
get_manifest() {
    python3 - <<EOF
import yaml, sys
with open("$MANIFEST") as f:
    data = yaml.safe_load(f)
keys = "$1".split(".")
val = data
for k in keys:
    val = val[k]
print(val)
EOF
}

# ══════════════════════════════════════════════════════
#  HELPER: Render a Jinja2 template from manifest
#  Usage: render_template input.j2 output.file
# ══════════════════════════════════════════════════════
render_template() {
    local template=$1
    local output=$2
    python3 - <<EOF
import yaml, jinja2, sys

with open("$MANIFEST") as f:
    data = yaml.safe_load(f)

with open("${TEMPLATES_DIR}/${template}") as f:
    tmpl = jinja2.Template(f.read())

rendered = tmpl.render(**data)

with open("$output", "w") as f:
    f.write(rendered)

print("Generated: $output")
EOF
}

# ══════════════════════════════════════════════════════
#  HELPER: Check if OPA is running
# ══════════════════════════════════════════════════════
opa_is_ready() {
    curl -sf "${OPA_URL}/health" > /dev/null 2>&1
}

# ══════════════════════════════════════════════════════
#  HELPER: Query OPA policy domain
#  Usage: query_opa "infrastructure" '{"disk_free_gb": 20}'
# ══════════════════════════════════════════════════════
query_opa() {
    local domain=$1
    local input_data=$2

    if ! opa_is_ready; then
        fail "OPA is unavailable — cannot make policy decision"
        fail "Start the stack first with: ./swiftdeploy deploy"
        exit 1
    fi

    local response
    response=$(curl -sf \
        -X POST \
        -H "Content-Type: application/json" \
        -d "{\"input\": ${input_data}}" \
        "${OPA_URL}/v1/data/${domain}" 2>&1)

    if [[ $? -ne 0 ]]; then
        fail "OPA request failed for domain '${domain}': ${response}"
        exit 1
    fi

    echo "$response"
}

# ══════════════════════════════════════════════════════
#  GATE: Pre-deploy policy check
# ══════════════════════════════════════════════════════
gate_pre_deploy() {
    info "Running pre-deploy policy checks..."

    # Collect host stats
    local disk_free_gb
    disk_free_gb=$(df -BG / | awk 'NR==2 {gsub("G",""); print $4}')

    local cpu_load
    cpu_load=$(awk '{print $1}' /proc/loadavg)

    local mem_total_mb
    mem_total_mb=$(free -m | awk 'NR==2 {print $2}')

    local mem_free_mb
    mem_free_mb=$(free -m | awk 'NR==2 {print $4}')

    info "Host stats → Disk: ${disk_free_gb}GB free | CPU load: ${cpu_load} | Mem: ${mem_free_mb}MB free"

    # Build input for OPA
    local input
    input=$(python3 -c "
import json
print(json.dumps({
    'disk_free_gb': float('${disk_free_gb}'),
    'cpu_load': float('${cpu_load}'),
    'mem_total_mb': float('${mem_total_mb}'),
    'mem_free_mb': float('${mem_free_mb}'),
    'check_type': 'pre-deploy'
}))
")

    # Query OPA infrastructure domain
    local result
    result=$(query_opa "infrastructure" "$input")

    local allowed
    allowed=$(echo "$result" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('result',{}).get('allow', False))" 2>/dev/null)

    local reasons
    reasons=$(echo "$result" | python3 -c "
import json, sys
d = json.load(sys.stdin)
denials = d.get('result', {}).get('deny', [])
for r in denials:
    print('  x ' + r)
" 2>/dev/null)

    if [[ "$allowed" == "True" ]]; then
        pass "Infrastructure policy: APPROVED"
    else
        fail "Infrastructure policy: DENIED"
        echo "$reasons"
        exit 1
    fi
}

# ══════════════════════════════════════════════════════
#  GATE: Pre-promote policy check
# ══════════════════════════════════════════════════════
gate_pre_promote() {
    info "Running pre-promote policy checks..."

    local nginx_port
    nginx_port=$(get_manifest "nginx.port")

    # Scrape /metrics from the app via Nginx
    local raw_metrics
    raw_metrics=$(curl -sf "http://localhost:${nginx_port}/metrics" 2>/dev/null)

    if [[ -z "$raw_metrics" ]]; then
        fail "Could not scrape /metrics — is the stack running?"
        exit 1
    fi

    # Calculate error rate and P99 latency using Python
    local stats
    stats=$(python3 - <<EOF
import re, json

metrics = """${raw_metrics}"""

# Total requests and errors
total = 0.0
errors = 0.0
for line in metrics.splitlines():
    m = re.match(r'http_requests_total\{.*status_code="(\d+)".*\}\s+([\d.]+)', line)
    if m:
        code, count = m.group(1), float(m.group(2))
        total += count
        if code.startswith('5'):
            errors += count

error_rate = (errors / total) if total > 0 else 0.0

# P99 latency from histogram buckets
buckets = []
for line in metrics.splitlines():
    m = re.match(r'http_request_duration_seconds_bucket\{.*le="([^"]+)".*\}\s+([\d.]+)', line)
    if m:
        le, count = m.group(1), float(m.group(2))
        if le != '+Inf':
            buckets.append((float(le), count))

p99_ms = 0.0
if buckets:
    total_obs = max(c for _, c in buckets) if buckets else 0
    p99_target = total_obs * 0.99
    for le, count in sorted(buckets):
        if count >= p99_target:
            p99_ms = le * 1000
            break

print(json.dumps({
    "error_rate": error_rate,
    "p99_latency_ms": p99_ms,
    "total_requests": total,
    "error_requests": errors,
    "check_type": "pre-promote"
}))
EOF
)

    info "Canary stats → $(echo $stats | python3 -c "
import json,sys
d=json.load(sys.stdin)
print(f'Error rate: {d[\"error_rate\"]*100:.2f}% | P99 latency: {d[\"p99_latency_ms\"]:.0f}ms | Total requests: {int(d[\"total_requests\"])}')
")"

    # Query OPA canary domain
    local result
    result=$(query_opa "canary" "$stats")

    local allowed
    allowed=$(echo "$result" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('result',{}).get('allow', False))" 2>/dev/null)

    local reasons
    reasons=$(echo "$result" | python3 -c "
import json, sys
d = json.load(sys.stdin)
denials = d.get('result', {}).get('deny', [])
for r in denials:
    print('  x ' + r)
" 2>/dev/null)

    if [[ "$allowed" == "True" ]]; then
        pass "Canary safety policy: APPROVED"
    else
        fail "Canary safety policy: DENIED"
        echo "$reasons"
        exit 1
    fi
}

# ══════════════════════════════════════════════════════
#  SUBCOMMAND: init
#  Parses manifest and generates nginx.conf + docker-compose.yml
# ══════════════════════════════════════════════════════
cmd_init() {
    info "Running init — generating config files from manifest..."

    pip install pyyaml jinja2 -q --break-system-packages

    render_template "nginx.conf.j2"          "$NGINX_CONF"
    render_template "docker-compose.yml.j2"  "$COMPOSE_FILE"

    pass "Init complete. Files generated:"
    echo "  → $NGINX_CONF"
    echo "  → $COMPOSE_FILE"
}

# ══════════════════════════════════════════════════════
#  SUBCOMMAND: validate
#  5 pre-flight checks before deploying
# ══════════════════════════════════════════════════════
cmd_validate() {
    info "Running pre-flight validation checks..."
    local errors=0

    # Check 1 — manifest.yaml exists and is valid YAML
    if python3 -c "import yaml; yaml.safe_load(open('$MANIFEST'))" 2>/dev/null; then
        pass "Check 1: manifest.yaml exists and is valid YAML"
    else
        fail "Check 1: manifest.yaml missing or invalid YAML"
        ((errors++))
    fi

    # Check 2 — Required fields present and non-empty
    required_fields=("services.image" "services.port" "nginx.image" "nginx.port" "network.name" "network.driver_type")
    all_fields_ok=true
    for field in "${required_fields[@]}"; do
        val=$(get_manifest "$field" 2>/dev/null || echo "")
        if [[ -z "$val" ]]; then
            fail "Check 2: Missing required field → $field"
            all_fields_ok=false
            ((errors++))
        fi
    done
    if $all_fields_ok; then
        pass "Check 2: All required fields present and non-empty"
    fi

    # Check 3 — Docker image exists locally
    IMAGE=$(get_manifest "services.image")
    if docker image inspect "$IMAGE" > /dev/null 2>&1; then
        pass "Check 3: Docker image '$IMAGE' exists locally"
    else
        fail "Check 3: Docker image '$IMAGE' not found locally — run 'docker build' first"
        ((errors++))
    fi

    # Check 4 — Nginx port not already bound on host
    NGINX_PORT=$(get_manifest "nginx.port")
    if ss -tuln 2>/dev/null | grep -q ":${NGINX_PORT} " || \
       netstat -tuln 2>/dev/null | grep -q ":${NGINX_PORT} "; then
        fail "Check 4: Port $NGINX_PORT is already in use on the host"
        ((errors++))
    else
        pass "Check 4: Port $NGINX_PORT is free on the host"
    fi

    # Check 5 — nginx.conf is syntactically valid
    if [[ ! -f "$NGINX_CONF" ]]; then
        fail "Check 5: $NGINX_CONF not found — run 'init' first"
        ((errors++))
    else
        TEMP_CONF=$(mktemp)
        sed 's/server app:/server 127.0.0.1:/g' "$NGINX_CONF" > "$TEMP_CONF"

        if docker run --rm \
            -v "${TEMP_CONF}:/etc/nginx/conf.d/default.conf:ro" \
            nginx:latest nginx -t 2>/dev/null; then
            pass "Check 5: nginx.conf is syntactically valid"
        else
            fail "Check 5: nginx.conf has syntax errors"
            ((errors++))
        fi
        rm -f "$TEMP_CONF"
    fi

    echo ""
    if [[ $errors -eq 0 ]]; then
        pass "All checks passed. Ready to deploy!"
    else
        fail "$errors check(s) failed. Fix the issues above before deploying."
        exit 1
    fi
}

# ══════════════════════════════════════════════════════
#  SUBCOMMAND: deploy
#  Runs init, gates on OPA, brings up stack, waits for health
# ══════════════════════════════════════════════════════
cmd_deploy() {
    info "Starting deployment..."

    cmd_init

    # Bring up OPA first so gate can query it
    info "Starting OPA container for policy checks..."
    docker compose -f "$COMPOSE_FILE" up -d opa

    # Wait for OPA to be ready
    local opa_wait=0
    until opa_is_ready; do
        if [[ $opa_wait -ge 30 ]]; then
            fail "OPA did not become ready in 30 seconds"
            exit 1
        fi
        sleep 2
        ((opa_wait+=2))
    done
    pass "OPA is ready"

    gate_pre_deploy

    info "Bringing up the full stack..."
    docker compose -f "$COMPOSE_FILE" up -d --build

    info "Waiting for health checks (timeout: 60s)..."
    local elapsed=0
    local interval=5

    until docker compose -f "$COMPOSE_FILE" ps | grep -q "healthy"; do
        if [[ $elapsed -ge 60 ]]; then
            fail "Health check timed out after 60 seconds."
            docker compose -f "$COMPOSE_FILE" logs
            exit 1
        fi
        echo "  ...waiting (${elapsed}s elapsed)"
        sleep $interval
        ((elapsed+=interval))
    done

    pass "Stack is up and healthy!"
    info "Access your service at: http://localhost:$(get_manifest 'nginx.port')"
}

# ══════════════════════════════════════════════════════
#  SUBCOMMAND: promote
#  Switches mode between canary and stable
# ══════════════════════════════════════════════════════
cmd_promote() {
    local target_mode="${1:-}"

    if [[ "$target_mode" != "canary" && "$target_mode" != "stable" ]]; then
        fail "Usage: ./swiftdeploy promote [canary|stable]"
        exit 1
    fi

    info "Promoting to '$target_mode' mode..."

    # Only run canary safety check when promoting TO stable
    if [[ "$target_mode" == "stable" ]]; then
        gate_pre_promote
    fi

    # Step 1 — Update mode in manifest.yaml in-place
    python3 - <<EOF
import yaml

with open("$MANIFEST", "r") as f:
    data = yaml.safe_load(f)

data["services"]["mode"] = "$target_mode"

with open("$MANIFEST", "w") as f:
    yaml.dump(data, f, default_flow_style=False)

print("Updated manifest.yaml → mode: $target_mode")
EOF

    # Step 2 — Regenerate docker-compose.yml with new MODE
    render_template "docker-compose.yml.j2" "$COMPOSE_FILE"
    pass "Regenerated docker-compose.yml"

    # Step 3 — Restart ONLY the app service container
    info "Restarting app container..."
    docker compose -f "$COMPOSE_FILE" up -d --no-deps --force-recreate app

    # Step 4 — Confirm new mode via /healthz
    info "Confirming new mode via /healthz..."
    sleep 3

    local port
    port=$(get_manifest "nginx.port")
    local response
    response=$(curl -s "http://localhost:${port}/healthz" || echo "")

    if [[ -n "$response" ]]; then
        pass "Service is responding after promote:"
        echo "$response" | python3 -m json.tool
    else
        fail "Service not responding after promote — check logs"
        exit 1
    fi

    pass "Promote to '$target_mode' complete!"
}

# ══════════════════════════════════════════════════════
#  SUBCOMMAND: status
#  Live-refreshing terminal dashboard
# ══════════════════════════════════════════════════════
cmd_status() {
    local nginx_port
    nginx_port=$(get_manifest "nginx.port")
    local interval=5

    info "Starting live status dashboard (Ctrl+C to stop)..."
    echo ""

    while true; do
        local raw_metrics
        raw_metrics=$(curl -sf "http://localhost:${nginx_port}/metrics" 2>/dev/null)

        if [[ -z "$raw_metrics" ]]; then
            fail "Cannot reach /metrics — is the stack running?"
            sleep $interval
            continue
        fi

        python3 - <<EOF
import re, json
from datetime import datetime, timezone

metrics = """${raw_metrics}"""

def get_gauge(name):
    m = re.search(rf'^{name}\s+([\d.]+)', metrics, re.MULTILINE)
    return float(m.group(1)) if m else 0.0

def get_counter_total(name):
    total = 0.0
    for m in re.finditer(rf'^{name}\{{.*\}}\s+([\d.]+)', metrics, re.MULTILINE):
        total += float(m.group(1))
    return total

def get_error_total():
    total = 0.0
    for m in re.finditer(r'http_requests_total\{.*status_code="(5\d\d)".*\}\s+([\d.]+)', metrics, re.MULTILINE):
        total += float(m.group(1))
    return total

uptime     = get_gauge("app_uptime_seconds")
mode_val   = get_gauge("app_mode")
chaos_val  = get_gauge("chaos_active")
total_reqs = get_counter_total("http_requests_total")
errors     = get_error_total()
error_rate = (errors / total_reqs * 100) if total_reqs > 0 else 0.0

mode_str  = "canary" if mode_val == 1.0 else "stable"
chaos_map = {0: "none", 1: "slow", 2: "error"}
chaos_str = chaos_map.get(int(chaos_val), "unknown")

snapshot = {
    "timestamp": datetime.now(timezone.utc).isoformat(),
    "uptime_seconds": uptime,
    "mode": mode_str,
    "chaos": chaos_str,
    "total_requests": total_reqs,
    "error_rate_pct": round(error_rate, 4),
}

with open("history.jsonl", "a") as f:
    f.write(json.dumps(snapshot) + "\n")

print("\033[2J\033[H", end="")
print("=" * 50)
print("  SwiftDeploy Live Status")
print(f"  {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
print("=" * 50)
print(f"  Mode        : {mode_str.upper()}")
print(f"  Uptime      : {uptime:.0f}s")
print(f"  Chaos       : {chaos_str}")
print(f"  Total Reqs  : {int(total_reqs)}")
print(f"  Error Rate  : {error_rate:.2f}%")
print("=" * 50)
print("  Policy Compliance:")
checks = [
    ("Chaos inactive",  chaos_str == "none"),
    ("Mode is stable",  mode_str == "stable"),
    ("Error rate < 1%", error_rate < 1.0),
]
for label, passing in checks:
    icon = "\033[32mv\033[0m" if passing else "\033[31mx\033[0m"
    print(f"    {icon} {label}")
print("=" * 50)
print("  Scraping every 5s | History -> history.jsonl")
EOF

        sleep $interval
    done
}

# ══════════════════════════════════════════════════════
#  SUBCOMMAND: audit
#  Generates audit_report.md from history.jsonl
# ══════════════════════════════════════════════════════
cmd_audit() {
    if [[ ! -f "$HISTORY_FILE" ]]; then
        fail "No history file found. Run './swiftdeploy status' first to collect data."
        exit 1
    fi

    info "Generating audit report..."

    python3 - <<EOF
import json
from datetime import datetime

entries = []
with open("history.jsonl") as f:
    for line in f:
        line = line.strip()
        if line:
            try:
                entries.append(json.loads(line))
            except:
                pass

if not entries:
    print("No data in history file.")
    exit(1)

lines = []
lines.append("# SwiftDeploy Audit Report")
lines.append(f"\nGenerated: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
lines.append(f"Total snapshots: {len(entries)}\n")

lines.append("## Timeline\n")
lines.append("| Timestamp | Mode | Chaos | Total Requests | Error Rate |")
lines.append("|-----------|------|-------|----------------|------------|")

for e in entries:
    ts       = e.get("timestamp", "")[:19].replace("T", " ")
    mode     = e.get("mode", "unknown")
    chaos    = e.get("chaos", "none")
    reqs     = int(e.get("total_requests", 0))
    err_rate = e.get("error_rate_pct", 0)
    lines.append(f"| {ts} | {mode} | {chaos} | {reqs} | {err_rate:.2f}% |")

lines.append("\n## Mode Changes\n")
mode_changes = []
for i in range(1, len(entries)):
    if entries[i]["mode"] != entries[i-1]["mode"]:
        mode_changes.append({
            "timestamp": entries[i]["timestamp"][:19].replace("T", " "),
            "from": entries[i-1]["mode"],
            "to": entries[i]["mode"]
        })

if mode_changes:
    lines.append("| Timestamp | From | To |")
    lines.append("|-----------|------|----|")
    for c in mode_changes:
        lines.append(f"| {c['timestamp']} | {c['from']} | {c['to']} |")
else:
    lines.append("_No mode changes recorded._")

lines.append("\n## Policy Violations\n")
violations = [e for e in entries if e.get("error_rate_pct", 0) >= 1.0 or e.get("chaos", "none") != "none"]

if violations:
    lines.append("| Timestamp | Chaos | Error Rate |")
    lines.append("|-----------|-------|------------|")
    for v in violations:
        ts       = v["timestamp"][:19].replace("T", " ")
        chaos    = v.get("chaos", "none")
        err_rate = v.get("error_rate_pct", 0)
        lines.append(f"| {ts} | {chaos} | {err_rate:.2f}% |")
else:
    lines.append("_No policy violations recorded._")

report = "\n".join(lines)
with open("audit_report.md", "w") as f:
    f.write(report)

print(report)
print("\nSaved to audit_report.md")
EOF

    pass "Audit report generated → audit_report.md"
}

# ══════════════════════════════════════════════════════
#  SUBCOMMAND: teardown
#  Removes all containers, networks, volumes
# ══════════════════════════════════════════════════════
cmd_teardown() {
    info "Tearing down the stack..."

    docker compose -f "$COMPOSE_FILE" down -v --remove-orphans

    pass "All containers, networks and volumes removed."

    if [[ "${1:-}" == "--clean" ]]; then
        info "Removing generated config files..."
        rm -f "$NGINX_CONF" "$COMPOSE_FILE"
        pass "Generated configs deleted."
    fi
}

# ══════════════════════════════════════════════════════
#  ENTRYPOINT — Route subcommands
# ══════════════════════════════════════════════════════
case "${1:-}" in
    init)       cmd_init ;;
    validate)   cmd_validate ;;
    deploy)     cmd_deploy ;;
    promote)    cmd_promote "${2:-}" ;;
    status)     cmd_status ;;
    audit)      cmd_audit ;;
    teardown)   cmd_teardown "${2:-}" ;;
    *)
        echo "SwiftDeploy CLI"
        echo "Usage: ./swiftdeploy [init|validate|deploy|promote|status|audit|teardown]"
        echo ""
        echo "  init              Generate nginx.conf + docker-compose.yml from manifest"
        echo "  validate          Run 5 pre-flight checks"
        echo "  deploy            Init + bring up stack + wait for health"
        echo "  promote [mode]    Switch to canary or stable mode"
        echo "  status            Live metrics dashboard"
        echo "  audit             Generate audit_report.md from history"
        echo "  teardown          Stop and remove all containers"
        echo "  teardown --clean  Also delete generated config files"
        exit 1
        ;;
esac
