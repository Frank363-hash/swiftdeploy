#!/bin/bash

set -euo pipefail

MANIFEST="manifest.yaml"
COMPOSE_FILE="docker-compose.yml"
NGINX_CONF="nginx.conf"
TEMPLATES_DIR="templates"

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' 

pass() { echo -e "${GREEN}[PASS]${NC} $1"; }
fail() { echo -e "${RED}[FAIL]${NC} $1"; }
info() { echo -e "${YELLOW}[INFO]${NC} $1"; }

get_manifest() {
    python3 - <<EOF
import yaml, sys
with open("$MANIFEST") as f:
    data = yaml.safe_load(f)
keys = "$1".split(".")
val = data
for k in keys:
    val = val[k]
print(val)
EOF
}

render_template() {
    local template=$1
    local output=$2
    python3 - <<EOF
import yaml, jinja2, sys

with open("$MANIFEST") as f:
    data = yaml.safe_load(f)

with open("${TEMPLATES_DIR}/${template}") as f:
    tmpl = jinja2.Template(f.read())

rendered = tmpl.render(**data)

with open("$output", "w") as f:
    f.write(rendered)

print("Generated: $output")
EOF
}

cmd_init() {
    info "Running init — generating config files from manifest..."

    # Install python deps needed for templating
    pip install pyyaml jinja2 -q --break-system-packages

    render_template "nginx.conf.j2"          "$NGINX_CONF"
    render_template "docker-compose.yml.j2"  "$COMPOSE_FILE"

    pass "Init complete. Files generated:"
    echo "  → $NGINX_CONF"
    echo "  → $COMPOSE_FILE"
}

cmd_validate() {
    info "Running pre-flight validation checks..."
    local errors=0

    # Check 1 — manifest.yaml exists and is valid YAML
    if python3 -c "import yaml; yaml.safe_load(open('$MANIFEST'))" 2>/dev/null; then
        pass "Check 1: manifest.yaml exists and is valid YAML"
    else
        fail "Check 1: manifest.yaml missing or invalid YAML"
        ((errors++))
    fi

    # Check 2 — Required fields present and non-empty
    required_fields=("services.image" "services.port" "nginx.image" "nginx.port" "network.name" "network.driver_type")
    all_fields_ok=true
    for field in "${required_fields[@]}"; do
        val=$(get_manifest "$field" 2>/dev/null || echo "")
        if [[ -z "$val" ]]; then
            fail "Check 2: Missing required field → $field"
            all_fields_ok=false
            ((errors++))
        fi
    done
    if $all_fields_ok; then
        pass "Check 2: All required fields present and non-empty"
    fi

    # Check 3 — Docker image exists locally
    IMAGE=$(get_manifest "services.image")
    if docker image inspect "$IMAGE" > /dev/null 2>&1; then
        pass "Check 3: Docker image '$IMAGE' exists locally"
    else
        fail "Check 3: Docker image '$IMAGE' not found locally — run 'docker build' first"
        ((errors++))
    fi

    # Check 4 — Nginx port not already bound on host
    NGINX_PORT=$(get_manifest "nginx.port")
    if ss -tuln 2>/dev/null | grep -q ":${NGINX_PORT} " || \
       netstat -tuln 2>/dev/null | grep -q ":${NGINX_PORT} "; then
        fail "Check 4: Port $NGINX_PORT is already in use on the host"
        ((errors++))
    else
        pass "Check 4: Port $NGINX_PORT is free on the host"
    fi

    # Check 5 — nginx.conf is syntactically valid
  if [[ ! -f "$NGINX_CONF" ]]; then
    fail "Check 5: $NGINX_CONF not found — run 'init' first"
    ((errors++))
else
    # Replace upstream hostname with localhost for syntax-only test
    TEMP_CONF=$(mktemp)
    sed 's/server app:/server 127.0.0.1:/g' "$NGINX_CONF" > "$TEMP_CONF"

    if docker run --rm \
        -v "${TEMP_CONF}:/etc/nginx/conf.d/default.conf:ro" \
        nginx:latest nginx -t 2>/dev/null; then
        pass "Check 5: nginx.conf is syntactically valid"
    else
        fail "Check 5: nginx.conf has syntax errors"
        ((errors++))
    fi
    rm -f "$TEMP_CONF"
fi
}

cmd_deploy() {
    info "Starting deployment..."

    cmd_init

    info "Bringing up the stack..."
    docker compose -f "$COMPOSE_FILE" up -d --build

    info "Waiting for health checks (timeout: 60s)..."
    local elapsed=0
    local interval=5

    until docker compose -f "$COMPOSE_FILE" ps | grep -q "healthy"; do
        if [[ $elapsed -ge 60 ]]; then
            fail "Health check timed out after 60 seconds."
            docker compose -f "$COMPOSE_FILE" logs
            exit 1
        fi
        echo "  ...waiting (${elapsed}s elapsed)"
        sleep $interval
        ((elapsed+=interval))
    done

    pass "Stack is up and healthy!"
    info "Access your service at: http://localhost:$(get_manifest 'nginx.port')"
}

cmd_promote() {
    local target_mode="${1:-}"

    if [[ "$target_mode" != "canary" && "$target_mode" != "stable" ]]; then
        fail "Usage: ./swiftdeploy promote [canary|stable]"
        exit 1
    fi

    info "Promoting to '$target_mode' mode..."
     python3 - <<EOF
import yaml

with open("$MANIFEST", "r") as f:
    data = yaml.safe_load(f)

data["services"]["mode"] = "$target_mode"

with open("$MANIFEST", "w") as f:
    yaml.dump(data, f, default_flow_style=False)

print("Updated manifest.yaml → mode: $target_mode")
EOF

   
    render_template "docker-compose.yml.j2" "$COMPOSE_FILE"
    pass "Regenerated docker-compose.yml"

    info "Restarting app container..."
    docker compose -f "$COMPOSE_FILE" up -d --no-deps --force-recreate app

    info "Confirming new mode via /healthz..."
    sleep 3

    local port
    port=$(get_manifest "nginx.port")
    local response
    response=$(curl -s "http://localhost:${port}/healthz" || echo "")

    if [[ -n "$response" ]]; then
        pass "Service is responding after promote:"
        echo "$response" | python3 -m json.tool
    else
        fail "Service not responding after promote — check logs"
        exit 1
    fi

    pass "Promote to '$target_mode' complete!"
}

cmd_teardown() {
    info "Tearing down the stack..."

    docker compose -f "$COMPOSE_FILE" down -v --remove-orphans

    pass "All containers, networks and volumes removed."

    # --clean flag also deletes generated config files
    if [[ "${1:-}" == "--clean" ]]; then
        info "Removing generated config files..."
        rm -f "$NGINX_CONF" "$COMPOSE_FILE"
        pass "Generated configs deleted."
    fi
}

case "${1:-}" in
    init)       cmd_init ;;
    validate)   cmd_validate ;;
    deploy)     cmd_deploy ;;
    promote)    cmd_promote "${2:-}" ;;
    teardown)   cmd_teardown "${2:-}" ;;
    *)
        echo "SwiftDeploy CLI"
        echo "Usage: ./swiftdeploy [init|validate|deploy|promote|teardown]"
        echo ""
        echo "  init              Generate nginx.conf + docker-compose.yml from manifest"
        echo "  validate          Run 5 pre-flight checks"
        echo "  deploy            Init + bring up stack + wait for health"
        echo "  promote [mode]    Switch to canary or stable mode"
        echo "  teardown          Stop and remove all containers"
        echo "  teardown --clean  Also delete generated config files"
        exit 1
        ;;
esac

